  "cards": [
    {
      "dot": "cyan",
      "title": "逻辑环境",
      "items": [
        "本地、隔离验收、生产是三类逻辑环境，不是已购资源",
        "所有平台与游戏表当前指向同一xj_play；环境数据隔离尚待方案确认",
        "公网来源与运营入口按最小暴露配置，实际域名与宿主未定"
      ]
    },
    {
      "dot": "emerald",
      "title": "运行职责",
      "items": [
        "管理端和玩家身份分别核验；支付回跳不能证明到账",
        "纯前端游戏没有数据库凭据；确需可信游戏后端时仅访问本游戏授权表",
        "浏览器宿主桥不持权益真相；资源模块在Java应用内，不是独立服务"
      ]
    },
    {
      "dot": "rose",
      "title": "恢复与成本",
      "items": [
        "MySQL当前binlog关闭，PITR与限制尾部完整性未证明",
        "备份/见证在独立故障域的方向已确认，资源和费用未批准",
        "RPO15分钟、RTO4小时仅为后续演练目标"
      ]
    }
  ]
