      "id": "cashMatch",
      "from": "cash",
      "to": "grant",
      "label": "核实到账与交付"
    },
    {
      "id": "scope",
      "from": "grant",
      "to": "resource",
      "label": "有效权益范围",
      "variant": "security"
    },
    {
      "id": "launch",
      "from": "browser",
      "to": "bridge",
      "label": "启动run请求",
      "variant": "security"
    },
    {
      "id": "gameRpc",
      "from": "game",
      "to": "bridge",
      "label": "游戏侧RPC／事件",
      "variant": "security"
    },
    {
      "id": "saveInput",
      "from": "bridge",
      "to": "save",
      "label": "存档操作／revision",
      "variant": "security"
    },
    {
      "id": "saveWrite",
      "from": "save",
      "to": "saveStore",
      "label": "对象引用与CAS"
    },
    {
      "id": "eventInput",
      "from": "bridge",
      "to": "event",
      "label": "event_ref＋可信run",
      "variant": "security"
    },
    {
      "id": "eventWrite",
      "from": "event",
      "to": "eventStore",
      "label": "派生去重键"
    },
    {
      "id": "objectRead",
      "from": "privateObjects",
      "to": "resource",
      "label": "固定资源版本",
      "variant": "security"
    },
    {
      "id": "readResource",
      "from": "resource",
      "to": "gameContent",
      "label": "受控正文／云档",
      "variant": "security"
    },
    {
      "id": "restore",
      "from": "saveStore",
      "to": "resource",
      "label": "云档引用／归属重核"
    },
    {
      "id": "aggregate",
      "from": "eventStore",
      "to": "analytics",
      "label": "脱敏行为统计",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "现金与权限",
      "items": [
        "回跳与游戏自报paid均不授予权益",
        "可信通知/查单核实金额、订单及商户后留现金事实",
        "唯一授予来源可重试；退款和限制使后续访问重新核验"
      ]
    },
    {
      "dot": "cyan",
      "title": "游戏与云档",
      "items": [
        "游戏保留自己的故事、谜题、页面和存档payload含义",
        "前端没有MySQL凭据；平台验证run、归属与权益",
        "对象先写不可变版本，再用同库CAS切换云档引用"
      ]
    },
    {
      "dot": "amber",
      "title": "分析边界",
      "items": [
        "游戏事件低信任；服务端绑定run/会话后派生event_key",
        "行为事件不改变现金或权益；晚到账形成可信修订",
        "这是设计数据流，不表示真实支付或数据处理器已运行"
      ]
    }
  ]
