digraph XJ {
graph [rankdir=LR, bgcolor="#fafbf7", nodesep=0.5, ranksep=1.2, fontname="Helvetica", label="间隙PLAY · 数据表逻辑关联 · 49张表 · 物理外键0条 · 设计未实施\n连线：虚线＝逻辑引用（无外键）；鸦爪＝多，竖线＝一，圆圈＝可空", labelloc=t];
node [shape=plain, fontname="Helvetica", fontsize=14];
edge [color="#526d60", arrowsize=0.7, fontname="Helvetica", fontsize=10];
subgraph cluster_0 { label="统一MySQL · xj_play / 身份"; color="#a8b9ad";
xj_subject [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_subject · 玩家主体与最小归属</B></TD></TR><TR><TD PORT="id" WIDTH="208" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="208" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="208" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="lifecycle" WIDTH="208" ALIGN="LEFT">lifecycle</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">ACTIVE/DELETION_REQUESTED/PROCESSING/DELETED/EXCEPTION</TD></TR><TR><TD PORT="email_verified" WIDTH="208" ALIGN="LEFT">email_verified</TD><TD  WIDTH="178" ALIGN="LEFT">BOOLEAN</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">与生命周期独立；后端维护</TD></TR><TR><TD PORT="session_generation" WIDTH="208" ALIGN="LEFT">session_generation</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">撤会话代次</TD></TR><TR><TD PORT="revision" WIDTH="208" ALIGN="LEFT">revision</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">乐观并发修订</TD></TR><TR><TD PORT="deleted_at" WIDTH="208" ALIGN="LEFT">deleted_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="568" ALIGN="LEFT">AD1最后确认时刻</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id)</TD></TR></TABLE>>];
xj_profile [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_profile · 私人账号资料</B></TD></TR><TR><TD PORT="id" WIDTH="188" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="188" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="178" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="188" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="subject_id" WIDTH="188" ALIGN="LEFT">subject_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">ref,uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">账号主体</TD></TR><TR><TD PORT="email_ciphertext" WIDTH="188" ALIGN="LEFT">email_ciphertext</TD><TD  WIDTH="178" ALIGN="LEFT">VARBINARY(2048)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">密钥管理环境加密邮箱</TD></TR><TR><TD PORT="email_lookup" WIDTH="188" ALIGN="LEFT">email_lookup</TD><TD  WIDTH="178" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="178" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">规范化邮箱带密钥检索摘要；不得当匿名数据</TD></TR><TR><TD PORT="password_hash" WIDTH="188" ALIGN="LEFT">password_hash</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(255)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">支持15–128码点的口令哈希；不裁剪</TD></TR><TR><TD PORT="nickname" WIDTH="188" ALIGN="LEFT">nickname</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">1–24 Unicode码点；不作为身份</TD></TR><TR><TD PORT="updated_at" WIDTH="188" ALIGN="LEFT">updated_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端更新时刻</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (subject_id); (email_lookup)</TD></TR></TABLE>>];
xj_session [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_session · 受控玩家会话</B></TD></TR><TR><TD PORT="id" WIDTH="148" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="148" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="148" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="subject_id" WIDTH="148" ALIGN="LEFT">subject_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="372" ALIGN="LEFT">游客时为空</TD></TR><TR><TD PORT="token_digest" WIDTH="148" ALIGN="LEFT">token_digest</TD><TD  WIDTH="178" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">只保存会话令牌摘要</TD></TR><TR><TD PORT="generation" WIDTH="148" ALIGN="LEFT">generation</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">绑定主体撤销代次</TD></TR><TR><TD PORT="expires_at" WIDTH="148" ALIGN="LEFT">expires_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端到期，不由客户端延长</TD></TR><TR><TD PORT="revoked_at" WIDTH="148" ALIGN="LEFT">revoked_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="372" ALIGN="LEFT">登出/重置/注销撤销</TD></TR><TR><TD PORT="purpose" WIDTH="148" ALIGN="LEFT">purpose</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">PLAYER/GUEST/SUPPORT受限目的</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (token_digest)</TD></TR></TABLE>>];
xj_identity_action [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_identity_action · 验证与找回动作</B></TD></TR><TR><TD PORT="id" WIDTH="148" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="148" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="148" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="subject_id" WIDTH="148" ALIGN="LEFT">subject_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="488" ALIGN="LEFT">防枚举响应可能无匹配主体</TD></TR><TR><TD PORT="action_type" WIDTH="148" ALIGN="LEFT">action_type</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(32)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">REGISTER/VERIFY/RESET/CHANGE_EMAIL/DELETE</TD></TR><TR><TD PORT="token_digest" WIDTH="148" ALIGN="LEFT">token_digest</TD><TD  WIDTH="178" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="488" ALIGN="LEFT">一次性令牌摘要</TD></TR><TR><TD PORT="state" WIDTH="148" ALIGN="LEFT">state</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">ACCEPTED/SENT/SUCCEEDED/FAILED/UNKNOWN/EXPIRED</TD></TR><TR><TD PORT="expires_at" WIDTH="148" ALIGN="LEFT">expires_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="488" ALIGN="LEFT">成功发出的验证链接30分钟</TD></TR><TR><TD PORT="revision" WIDTH="148" ALIGN="LEFT">revision</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">成功重发切换有效动作代次</TD></TR><TR><TD PORT="completed_at" WIDTH="148" ALIGN="LEFT">completed_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="488" ALIGN="LEFT">动作真正完成</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id)</TD></TR></TABLE>>];
xj_deletion_request [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_deletion_request · AD1注销申请</B></TD></TR><TR><TD PORT="id" WIDTH="208" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="758" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="208" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="758" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="208" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="758" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="subject_id" WIDTH="208" ALIGN="LEFT">subject_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="758" ALIGN="LEFT">原账号</TD></TR><TR><TD PORT="state" WIDTH="208" ALIGN="LEFT">state</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="758" ALIGN="LEFT">REQUESTED/REVIEWING/AWAIT_CONFIRM/WITHDRAWN/PROCESSING/COMPLETE/EXCEPTION</TD></TR><TR><TD PORT="policy_version" WIDTH="208" ALIGN="LEFT">policy_version</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(128)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="758" ALIGN="LEFT">已展示并确认的处理范围版本</TD></TR><TR><TD PORT="blocking_refs" WIDTH="208" ALIGN="LEFT">blocking_refs</TD><TD  WIDTH="178" ALIGN="LEFT">JSON</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="758" ALIGN="LEFT">具体在途业务和责任，不能冻结全部数据</TD></TR><TR><TD PORT="final_confirmed_at" WIDTH="208" ALIGN="LEFT">final_confirmed_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="758" ALIGN="LEFT">T_delete；不可逆处理前最后确认</TD></TR><TR><TD PORT="next_review_at" WIDTH="208" ALIGN="LEFT">next_review_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="758" ALIGN="LEFT">个案下一复核</TD></TR><TR><TD PORT="revision" WIDTH="208" ALIGN="LEFT">revision</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="758" ALIGN="LEFT">流程并发修订</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id)</TD></TR></TABLE>>];
}
subgraph cluster_1 { label="统一MySQL · xj_play / 目录"; color="#a8b9ad";
xj_game [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_game · 作品元数据</B></TD></TR><TR><TD PORT="id" WIDTH="168" ALIGN="LEFT">id</TD><TD  WIDTH="268" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="168" ALIGN="LEFT">public_id</TD><TD  WIDTH="268" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="168" ALIGN="LEFT">created_at</TD><TD  WIDTH="268" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="slug" WIDTH="168" ALIGN="LEFT">slug</TD><TD  WIDTH="268" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">公开路径标识</TD></TR><TR><TD PORT="title" WIDTH="168" ALIGN="LEFT">title</TD><TD  WIDTH="268" ALIGN="LEFT">VARCHAR(80)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">名称1–80码点</TD></TR><TR><TD PORT="summary" WIDTH="168" ALIGN="LEFT">summary</TD><TD  WIDTH="268" ALIGN="LEFT">VARCHAR(160)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">短摘要1–160码点</TD></TR><TR><TD PORT="description" WIDTH="168" ALIGN="LEFT">description</TD><TD  WIDTH="268" ALIGN="LEFT">TEXT</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">发布正文1–2000码点，安全渲染</TD></TR><TR><TD PORT="media" WIDTH="168" ALIGN="LEFT">media</TD><TD  WIDTH="268" ALIGN="LEFT">JSON</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">1封面/0–8截图；公开资源编号</TD></TR><TR><TD PORT="declarations" WIDTH="168" ALIGN="LEFT">declarations</TD><TD  WIDTH="268" ALIGN="LEFT">JSON</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">内容/设备/语言/声音/存档声明</TD></TR><TR><TD PORT="sale_state" WIDTH="168" ALIGN="LEFT">sale_state</TD><TD  WIDTH="268" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">DRAFT/ON_SALE/DELISTED</TD></TR><TR><TD PORT="runtime_state" WIDTH="168" ALIGN="LEFT">runtime_state</TD><TD  WIDTH="268" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">AVAILABLE/SUSPENDED/TERMINATING/CLOSED</TD></TR><TR><TD PORT="data_namespace" WIDTH="168" ALIGN="LEFT">data_namespace</TD><TD  WIDTH="268" ALIGN="LEFT">VARCHAR(32) ASCII BINARY</TD><TD  WIDTH="138" ALIGN="LEFT">uk NULL</TD><TD  WIDTH="498" ALIGN="LEFT">独立游戏表前缀登记，如xjg_ga_；未接入时空，登记后不可复用</TD></TR><TR><TD PORT="published_at" WIDTH="168" ALIGN="LEFT">published_at</TD><TD  WIDTH="268" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="498" ALIGN="LEFT">默认排序依据</TD></TR><TR><TD PORT="revision" WIDTH="168" ALIGN="LEFT">revision</TD><TD  WIDTH="268" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">运营修改并发</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (slug); (data_namespace)</TD></TR></TABLE>>];
xj_game_version [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_game_version · 不可变游戏版本</B></TD></TR><TR><TD PORT="id" WIDTH="178" ALIGN="LEFT">id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="178" ALIGN="LEFT">public_id</TD><TD  WIDTH="208" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="178" ALIGN="LEFT">created_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="game_id" WIDTH="178" ALIGN="LEFT">game_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">所属作品</TD></TR><TR><TD PORT="version" WIDTH="178" ALIGN="LEFT">version</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">游戏自有版本标签</TD></TR><TR><TD PORT="manifest_digest" WIDTH="178" ALIGN="LEFT">manifest_digest</TD><TD  WIDTH="208" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">审核manifest摘要</TD></TR><TR><TD PORT="package_digest" WIDTH="178" ALIGN="LEFT">package_digest</TD><TD  WIDTH="208" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">资源包摘要</TD></TR><TR><TD PORT="entry_path" WIDTH="178" ALIGN="LEFT">entry_path</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(512)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">已标准化入口</TD></TR><TR><TD PORT="protocol_range" WIDTH="178" ALIGN="LEFT">protocol_range</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">消息协议兼容范围</TD></TR><TR><TD PORT="save_formats" WIDTH="178" ALIGN="LEFT">save_formats</TD><TD  WIDTH="208" ALIGN="LEFT">JSON</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">写入及接受格式；游戏解释迁移</TD></TR><TR><TD PORT="state" WIDTH="178" ALIGN="LEFT">state</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">UPLOADED/CHECKING/REVIEW/PUBLISHED/REJECTED/DISABLED</TD></TR><TR><TD PORT="update_notes" WIDTH="178" ALIGN="LEFT">update_notes</TD><TD  WIDTH="208" ALIGN="LEFT">TEXT</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">发布1–1000码点</TD></TR><TR><TD PORT="revision" WIDTH="178" ALIGN="LEFT">revision</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">审核/发布修订，不修改包</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (game_id,version)</TD></TR></TABLE>>];
xj_resource [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_resource · 私有资源索引</B></TD></TR><TR><TD PORT="id" WIDTH="198" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="198" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="198" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="version_id" WIDTH="198" ALIGN="LEFT">version_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">固定游戏版本</TD></TR><TR><TD PORT="path" WIDTH="198" ALIGN="LEFT">path</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(512)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">规范路径，拒穿越及碰撞</TD></TR><TR><TD PORT="storage_object_id" WIDTH="198" ALIGN="LEFT">storage_object_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">精确不可变对象；只在后端解析</TD></TR><TR><TD PORT="visibility" WIDTH="198" ALIGN="LEFT">visibility</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">PUBLIC/PROTECTED</TD></TR><TR><TD PORT="required_keys" WIDTH="198" ALIGN="LEFT">required_keys</TD><TD  WIDTH="178" ALIGN="LEFT">JSON</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">需要全部满足的本作品contentKey清单</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (version_id,path)</TD></TR></TABLE>>];
xj_content_key [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_content_key · 稳定内容标识</B></TD></TR><TR><TD PORT="id" WIDTH="188" ALIGN="LEFT">id</TD><TD  WIDTH="278" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="188" ALIGN="LEFT">public_id</TD><TD  WIDTH="278" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="188" ALIGN="LEFT">created_at</TD><TD  WIDTH="278" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="game_id" WIDTH="188" ALIGN="LEFT">game_id</TD><TD  WIDTH="278" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">作品</TD></TR><TR><TD PORT="content_key" WIDTH="188" ALIGN="LEFT">content_key</TD><TD  WIDTH="278" ALIGN="LEFT">VARCHAR(128) ASCII BINARY</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">1–128 ASCII，作品内大小写精确</TD></TR><TR><TD PORT="meaning" WIDTH="188" ALIGN="LEFT">meaning</TD><TD  WIDTH="278" ALIGN="LEFT">VARCHAR(1000)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">已售含义/范围说明，不能复用缩减</TD></TR><TR><TD PORT="version_coverage" WIDTH="188" ALIGN="LEFT">version_coverage</TD><TD  WIDTH="278" ALIGN="LEFT">JSON</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">哪些不可变版本兑现该含义</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (game_id,content_key)</TD></TR></TABLE>>];
xj_product_revision [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_product_revision · 商品承诺快照</B></TD></TR><TR><TD PORT="id" WIDTH="138" ALIGN="LEFT">id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="138" ALIGN="LEFT">public_id</TD><TD  WIDTH="208" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="138" ALIGN="LEFT">created_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="game_id" WIDTH="138" ALIGN="LEFT">game_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">作品</TD></TR><TR><TD PORT="product_key" WIDTH="138" ALIGN="LEFT">product_key</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">逻辑商品</TD></TR><TR><TD PORT="revision_no" WIDTH="138" ALIGN="LEFT">revision_no</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">每版不可变承诺</TD></TR><TR><TD PORT="kind" WIDTH="138" ALIGN="LEFT">kind</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">BUYOUT/CHAPTER/SCENE/FREE</TD></TR><TR><TD PORT="price_fen" WIDTH="138" ALIGN="LEFT">price_fen</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">CNY分；业务输入≤999999；FREE=0</TD></TR><TR><TD PORT="currency" WIDTH="138" ALIGN="LEFT">currency</TD><TD  WIDTH="208" ALIGN="LEFT">CHAR(3) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">当前仅CNY</TD></TR><TR><TD PORT="promise" WIDTH="138" ALIGN="LEFT">promise</TD><TD  WIDTH="208" ALIGN="LEFT">TEXT</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">购买时明确承诺，不包含所有未来DLC</TD></TR><TR><TD PORT="sale_state" WIDTH="138" ALIGN="LEFT">sale_state</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">DRAFT/ON_SALE/DELISTED</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (game_id,product_key,revision_no)</TD></TR></TABLE>>];
xj_product_scope [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_product_scope · 商品内容覆盖</B></TD></TR><TR><TD PORT="id" WIDTH="218" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="218" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="218" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="product_revision_id" WIDTH="218" ALIGN="LEFT">product_revision_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">不可变商品版</TD></TR><TR><TD PORT="content_id" WIDTH="218" ALIGN="LEFT">content_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">同作品内容标识</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (product_revision_id,content_id)</TD></TR></TABLE>>];
xj_release_attempt [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_release_attempt · 预览审核与发布尝试</B></TD></TR><TR><TD PORT="id" WIDTH="198" ALIGN="LEFT">id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="406" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="198" ALIGN="LEFT">public_id</TD><TD  WIDTH="208" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="406" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="198" ALIGN="LEFT">created_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="406" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="version_id" WIDTH="198" ALIGN="LEFT">version_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="406" ALIGN="LEFT">指定版本</TD></TR><TR><TD PORT="operator_ref" WIDTH="198" ALIGN="LEFT">operator_ref</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="406" ALIGN="LEFT">既有管理员身份引用，不信客户端自报</TD></TR><TR><TD PORT="expected_revision" WIDTH="198" ALIGN="LEFT">expected_revision</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="406" ALIGN="LEFT">发布前版本修订</TD></TR><TR><TD PORT="checks" WIDTH="198" ALIGN="LEFT">checks</TD><TD  WIDTH="208" ALIGN="LEFT">JSON</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="406" ALIGN="LEFT">静态检查、预览权限、隔离/兼容及正式资源验证结果</TD></TR><TR><TD PORT="state" WIDTH="198" ALIGN="LEFT">state</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="406" ALIGN="LEFT">ACCEPTED/REJECTED/PUBLISHED/UNKNOWN</TD></TR><TR><TD PORT="completed_at" WIDTH="198" ALIGN="LEFT">completed_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="406" ALIGN="LEFT">实际发布生效</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id)</TD></TR></TABLE>>];
}
subgraph cluster_2 { label="统一MySQL · xj_play / 交易"; color="#a8b9ad";
xj_guard [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_guard · 账号作品并发守卫</B></TD></TR><TR><TD PORT="id" WIDTH="178" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="178" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="178" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="subject_id" WIDTH="178" ALIGN="LEFT">subject_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">账号</TD></TR><TR><TD PORT="game_id" WIDTH="178" ALIGN="LEFT">game_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">作品</TD></TR><TR><TD PORT="access_revision" WIDTH="178" ALIGN="LEFT">access_revision</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">授予/撤销变化递增</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (subject_id,game_id)</TD></TR></TABLE>>];
xj_purchase_intent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_purchase_intent · 购买返回意图</B></TD></TR><TR><TD PORT="id" WIDTH="258" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="726" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="258" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="726" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="258" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="726" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="run_id" WIDTH="258" ALIGN="LEFT">run_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="726" ALIGN="LEFT">原运行上下文</TD></TR><TR><TD PORT="guest_session_id" WIDTH="258" ALIGN="LEFT">guest_session_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="726" ALIGN="LEFT">GUEST创建时的原会话，须与原run.session_id一致；PLAYER直达为空</TD></TR><TR><TD PORT="version_id" WIDTH="258" ALIGN="LEFT">version_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="726" ALIGN="LEFT">原run实际版本快照；正常EXITED后仍核历史归属</TD></TR><TR><TD PORT="game_id" WIDTH="258" ALIGN="LEFT">game_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="726" ALIGN="LEFT">原版本所属作品快照，与version.game_id一致</TD></TR><TR><TD PORT="origin_run_validated_at" WIDTH="258" ALIGN="LEFT">origin_run_validated_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="726" ALIGN="LEFT">创建当刻服务端验证run有效的时刻；之后正常EXITED不撤销意图</TD></TR><TR><TD PORT="subject_id" WIDTH="258" ALIGN="LEFT">subject_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="726" ALIGN="LEFT">GUEST创建时为空，bind后写入；PLAYER直达取当前可信会话主体</TD></TR><TR><TD PORT="content_keys" WIDTH="258" ALIGN="LEFT">content_keys</TD><TD  WIDTH="178" ALIGN="LEFT">JSON</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="726" ALIGN="LEFT">所需内容范围，不含金额/权限事实</TD></TR><TR><TD PORT="resume_handle" WIDTH="258" ALIGN="LEFT">resume_handle</TD><TD  WIDTH="178" ALIGN="LEFT">TEXT</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="726" ALIGN="LEFT">游戏自有不透明位置；限制长度且无凭据</TD></TR><TR><TD PORT="expires_at" WIDTH="258" ALIGN="LEFT">expires_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="726" ALIGN="LEFT">仅GUEST登录交接资格GP1确认创建后30分钟；PLAYER直达为空，不截断已建handoff的15分钟</TD></TR><TR><TD PORT="bound_at" WIDTH="258" ALIGN="LEFT">bound_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="726" ALIGN="LEFT">GUEST首次bind或PLAYER直达创建的绑定时刻；GP1确认位置保留至其后24小时</TD></TR><TR><TD PORT="bound_player_session_id" WIDTH="258" ALIGN="LEFT">bound_player_session_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="726" ALIGN="LEFT">GUEST首次bind目标会话或PLAYER直达创建的当前可信会话</TD></TR><TR><TD PORT="bind_key_digest" WIDTH="258" ALIGN="LEFT">bind_key_digest</TD><TD  WIDTH="178" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="726" ALIGN="LEFT">仅GUEST首次bind的作用域幂等键摘要；PLAYER直达为空</TD></TR><TR><TD PORT="state" WIDTH="258" ALIGN="LEFT">state</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="726" ALIGN="LEFT">GUEST创建OPEN再bind为BOUND；PLAYER直达创建BOUND；RETURNED/CANCELLED</TD></TR><TR><TD PORT="return_run_id" WIDTH="258" ALIGN="LEFT">return_run_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref,uk NULL</TD><TD  WIDTH="726" ALIGN="LEFT">RT1服务端核验后绑定承接位置的新运行</TD></TR><TR><TD PORT="return_issued_at" WIDTH="258" ALIGN="LEFT">return_issued_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="726" ALIGN="LEFT">受控位置交付时刻；不写URL/日志</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (return_run_id)</TD></TR></TABLE>>];
xj_intent_handoff [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_intent_handoff · 游客意图登录会话交接</B></TD></TR><TR><TD PORT="id" WIDTH="198" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="198" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="178" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="198" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="intent_id" WIDTH="198" ALIGN="LEFT">intent_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">ref,uk NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">仅指定GUEST意图一对一交接；唯一键保留防换号认领</TD></TR><TR><TD PORT="guest_session_id" WIDTH="198" ALIGN="LEFT">guest_session_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">登录时有效的原guest Cookie解析结果，与意图及原run历史快照一致</TD></TR><TR><TD PORT="player_session_id" WIDTH="198" ALIGN="LEFT">player_session_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">同次成功登录签发的目标PLAYER会话</TD></TR><TR><TD PORT="subject_id" WIDTH="198" ALIGN="LEFT">subject_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">成功认证的目标账号，取服务端会话，不接受客户端自报</TD></TR><TR><TD PORT="expires_at" WIDTH="198" ALIGN="LEFT">expires_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">GP1确认登录后15分钟；不受此前30分钟登录资格或guest自然到期截断</TD></TR><TR><TD PORT="state" WIDTH="198" ALIGN="LEFT">state</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">ACTIVE/CONSUMED/REVOKED；到期另按时间条件判断</TD></TR><TR><TD PORT="consumed_at" WIDTH="198" ALIGN="LEFT">consumed_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="178" ALIGN="LEFT"> NULL</TD><TD  WIDTH="548" ALIGN="LEFT">首次成功绑定时同事务置CONSUMED</TD></TR><TR><TD PORT="revoked_at" WIDTH="198" ALIGN="LEFT">revoked_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="178" ALIGN="LEFT"> NULL</TD><TD  WIDTH="548" ALIGN="LEFT">取消、安全撤销或目标会话撤销时失效</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (intent_id)</TD></TR></TABLE>>];
xj_quote [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_quote · 服务端报价</B></TD></TR><TR><TD PORT="id" WIDTH="218" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="218" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="218" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="subject_id" WIDTH="218" ALIGN="LEFT">subject_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">已验证账号</TD></TR><TR><TD PORT="product_revision_id" WIDTH="218" ALIGN="LEFT">product_revision_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">目标商品承诺</TD></TR><TR><TD PORT="intent_id" WIDTH="218" ALIGN="LEFT">intent_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="372" ALIGN="LEFT">购买返回意图</TD></TR><TR><TD PORT="sources_snapshot" WIDTH="218" ALIGN="LEFT">sources_snapshot</TD><TD  WIDTH="178" ALIGN="LEFT">JSON</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">合格现金来源、净额、覆盖、处置修订</TD></TR><TR><TD PORT="price_fen" WIDTH="218" ALIGN="LEFT">price_fen</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">目标买断/商品价</TD></TR><TR><TD PORT="credit_fen" WIDTH="218" ALIGN="LEFT">credit_fen</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">去重抵扣，不超目标价</TD></TR><TR><TD PORT="due_fen" WIDTH="218" ALIGN="LEFT">due_fen</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">应补非负；0时不走支付</TD></TR><TR><TD PORT="expires_at" WIDTH="218" ALIGN="LEFT">expires_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">报价生成后10分钟展示有效，提交仍重核</TD></TR><TR><TD PORT="access_revision" WIDTH="218" ALIGN="LEFT">access_revision</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">报价时守卫修订</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id)</TD></TR></TABLE>>];
xj_order [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_order · 需付款订单</B></TD></TR><TR><TD PORT="id" WIDTH="188" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="188" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="178" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="188" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="subject_id" WIDTH="188" ALIGN="LEFT">subject_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">已验证账号</TD></TR><TR><TD PORT="game_id" WIDTH="188" ALIGN="LEFT">game_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">作品</TD></TR><TR><TD PORT="quote_id" WIDTH="188" ALIGN="LEFT">quote_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">ref,uk NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">唯一已确认报价</TD></TR><TR><TD PORT="promise_snapshot" WIDTH="188" ALIGN="LEFT">promise_snapshot</TD><TD  WIDTH="178" ALIGN="LEFT">JSON</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">名称/商品版/承诺/范围/币种/价格快照</TD></TR><TR><TD PORT="due_fen" WIDTH="188" ALIGN="LEFT">due_fen</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">实际应付&gt;0且≤999999</TD></TR><TR><TD PORT="currency" WIDTH="188" ALIGN="LEFT">currency</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(3) ASCII</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">CNY</TD></TR><TR><TD PORT="payment_state" WIDTH="188" ALIGN="LEFT">payment_state</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">PENDING/VERIFYING/PAID/UNPAID_CLOSED/EXCEPTION</TD></TR><TR><TD PORT="delivery_state" WIDTH="188" ALIGN="LEFT">delivery_state</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">NOT_DUE/PENDING/DELIVERED/EXCEPTION</TD></TR><TR><TD PORT="purpose" WIDTH="188" ALIGN="LEFT">purpose</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">LIVE/TEST/PREVIEW不得混报</TD></TR><TR><TD PORT="revision" WIDTH="188" ALIGN="LEFT">revision</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="488" ALIGN="LEFT">并发状态</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (quote_id)</TD></TR></TABLE>>];
xj_order_scope [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_order_scope · 已售覆盖快照</B></TD></TR><TR><TD PORT="id" WIDTH="188" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="188" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="188" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="order_id" WIDTH="188" ALIGN="LEFT">order_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">订单</TD></TR><TR><TD PORT="content_id" WIDTH="188" ALIGN="LEFT">content_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">已售内容含义</TD></TR><TR><TD PORT="meaning_snapshot" WIDTH="188" ALIGN="LEFT">meaning_snapshot</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(1000)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">当次承诺，后续不覆盖</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (order_id,content_id)</TD></TR></TABLE>>];
xj_payment_attempt [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_payment_attempt · 双渠道付款尝试</B></TD></TR><TR><TD PORT="id" WIDTH="148" ALIGN="LEFT">id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="148" ALIGN="LEFT">public_id</TD><TD  WIDTH="208" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="148" ALIGN="LEFT">created_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="order_id" WIDTH="148" ALIGN="LEFT">order_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">同一业务订单</TD></TR><TR><TD PORT="channel" WIDTH="148" ALIGN="LEFT">channel</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">ALIPAY/WECHAT</TD></TR><TR><TD PORT="merchant_ref" WIDTH="148" ALIGN="LEFT">merchant_ref</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">环境中的非秘密商户配置引用</TD></TR><TR><TD PORT="method" WIDTH="148" ALIGN="LEFT">method</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(32)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">首期PAGE/WAP/NATIVE/H5；JSAPI/小程序为后续候选，当前不接受</TD></TR><TR><TD PORT="out_trade_no" WIDTH="148" ALIGN="LEFT">out_trade_no</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(64) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">服务器生成且符合渠道长度/字符要求</TD></TR><TR><TD PORT="state" WIDTH="148" ALIGN="LEFT">state</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">CREATING/WAITING/UNKNOWN/SUCCESS/CLOSED/FAILED</TD></TR><TR><TD PORT="close_state" WIDTH="148" ALIGN="LEFT">close_state</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">NONE/REQUESTED/CONFIRMED/UNKNOWN</TD></TR><TR><TD PORT="expires_at" WIDTH="148" ALIGN="LEFT">expires_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="540" ALIGN="LEFT">渠道受理的到期时间，不等同本地倒计时</TD></TR><TR><TD PORT="revision" WIDTH="148" ALIGN="LEFT">revision</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">切渠道和关单守卫</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (channel,merchant_ref,out_trade_no)</TD></TR></TABLE>>];
xj_payment_notice [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_payment_notice · 通知查证收件</B></TD></TR><TR><TD PORT="id" WIDTH="208" ALIGN="LEFT">id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="388" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="208" ALIGN="LEFT">public_id</TD><TD  WIDTH="208" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="388" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="208" ALIGN="LEFT">created_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="388" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="attempt_id" WIDTH="208" ALIGN="LEFT">attempt_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="388" ALIGN="LEFT">已核对付款尝试</TD></TR><TR><TD PORT="channel" WIDTH="208" ALIGN="LEFT">channel</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="388" ALIGN="LEFT">ALIPAY/WECHAT</TD></TR><TR><TD PORT="merchant_ref" WIDTH="208" ALIGN="LEFT">merchant_ref</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="388" ALIGN="LEFT">核对应用/商户上下文</TD></TR><TR><TD PORT="notice_key" WIDTH="208" ALIGN="LEFT">notice_key</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="388" ALIGN="LEFT">通知标识或规范摘要，不等于付款唯一号</TD></TR><TR><TD PORT="body_digest" WIDTH="208" ALIGN="LEFT">body_digest</TD><TD  WIDTH="208" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="388" ALIGN="LEFT">原始字节摘要；敏感原文分类隔离非普通日志</TD></TR><TR><TD PORT="evidence_object_id" WIDTH="208" ALIGN="LEFT">evidence_object_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="388" ALIGN="LEFT">受限通知信封的精确版本；不返回前台</TD></TR><TR><TD PORT="verification_state" WIDTH="208" ALIGN="LEFT">verification_state</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="388" ALIGN="LEFT">RECEIVED/VERIFIED/REJECTED/UNMATCHED</TD></TR><TR><TD PORT="processed_at" WIDTH="208" ALIGN="LEFT">processed_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="388" ALIGN="LEFT">持久处理后才应答成功</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (channel,merchant_ref,notice_key)</TD></TR></TABLE>>];
xj_cash_fact [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_cash_fact · 可信实收事实</B></TD></TR><TR><TD PORT="id" WIDTH="218" ALIGN="LEFT">id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="218" ALIGN="LEFT">public_id</TD><TD  WIDTH="208" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="218" ALIGN="LEFT">created_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="order_id" WIDTH="218" ALIGN="LEFT">order_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">原订单</TD></TR><TR><TD PORT="attempt_id" WIDTH="218" ALIGN="LEFT">attempt_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">支付尝试</TD></TR><TR><TD PORT="channel" WIDTH="218" ALIGN="LEFT">channel</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">ALIPAY/WECHAT</TD></TR><TR><TD PORT="merchant_ref" WIDTH="218" ALIGN="LEFT">merchant_ref</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">非秘密商户引用</TD></TR><TR><TD PORT="channel_trade_no" WIDTH="218" ALIGN="LEFT">channel_trade_no</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">渠道交易唯一号</TD></TR><TR><TD PORT="received_fen" WIDTH="218" ALIGN="LEFT">received_fen</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">实际收款；异常超额仍完整保存</TD></TR><TR><TD PORT="currency" WIDTH="218" ALIGN="LEFT">currency</TD><TD  WIDTH="208" ALIGN="LEFT">CHAR(3) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">核实币种</TD></TR><TR><TD PORT="occurred_at" WIDTH="218" ALIGN="LEFT">occurred_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">可信渠道发生时刻</TD></TR><TR><TD PORT="verified_at" WIDTH="218" ALIGN="LEFT">verified_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">核实时间，用于迟到修订</TD></TR><TR><TD PORT="refunded_fen" WIDTH="218" ALIGN="LEFT">refunded_fen</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">已确认退款累计</TD></TR><TR><TD PORT="refund_reserved_fen" WIDTH="218" ALIGN="LEFT">refund_reserved_fen</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">未知/在途退款预留</TD></TR><TR><TD PORT="allocation_state" WIDTH="218" ALIGN="LEFT">allocation_state</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">PRIMARY/DUPLICATE/AMOUNT_MISMATCH/REVIEW</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (channel,merchant_ref,channel_trade_no)</TD></TR></TABLE>>];
xj_refund [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_refund · 现金退款与撤权</B></TD></TR><TR><TD PORT="id" WIDTH="198" ALIGN="LEFT">id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="198" ALIGN="LEFT">public_id</TD><TD  WIDTH="208" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="198" ALIGN="LEFT">created_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="cash_fact_id" WIDTH="198" ALIGN="LEFT">cash_fact_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">原路现金来源</TD></TR><TR><TD PORT="support_id" WIDTH="198" ALIGN="LEFT">support_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">人工售后批准</TD></TR><TR><TD PORT="out_refund_no" WIDTH="198" ALIGN="LEFT">out_refund_no</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(64) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">稳定商户退款号</TD></TR><TR><TD PORT="channel" WIDTH="198" ALIGN="LEFT">channel</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">原现金对应ALIPAY/WECHAT；服务端匹配</TD></TR><TR><TD PORT="merchant_ref" WIDTH="198" ALIGN="LEFT">merchant_ref</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">原现金商户引用；服务器核对</TD></TR><TR><TD PORT="amount_fen" WIDTH="198" ALIGN="LEFT">amount_fen</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">&gt;0；已退+保留+本次不超该笔实收</TD></TR><TR><TD PORT="channel_refund_no" WIDTH="198" ALIGN="LEFT">channel_refund_no</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="438" ALIGN="LEFT">渠道退款号</TD></TR><TR><TD PORT="cash_state" WIDTH="198" ALIGN="LEFT">cash_state</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">APPROVED/SENDING/UNKNOWN/SUCCEEDED/FAILED</TD></TR><TR><TD PORT="rights_state" WIDTH="198" ALIGN="LEFT">rights_state</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">PENDING/ADJUSTED/EXCEPTION</TD></TR><TR><TD PORT="rights_plan" WIDTH="198" ALIGN="LEFT">rights_plan</TD><TD  WIDTH="208" ALIGN="LEFT">JSON</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">获准撤哪份来源/范围及升级关联，不按金额比例删内容</TD></TR><TR><TD PORT="occurred_at" WIDTH="198" ALIGN="LEFT">occurred_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="438" ALIGN="LEFT">退款可信发生</TD></TR><TR><TD PORT="verified_at" WIDTH="198" ALIGN="LEFT">verified_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="438" ALIGN="LEFT">退款核实</TD></TR><TR><TD PORT="revision" WIDTH="198" ALIGN="LEFT">revision</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">批准/执行/核实并发修订</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (channel,merchant_ref,out_refund_no)</TD></TR></TABLE>>];
xj_fee_fact [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_fee_fact · 费用与调整事实</B></TD></TR><TR><TD PORT="id" WIDTH="148" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="148" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="148" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="cash_fact_id" WIDTH="148" ALIGN="LEFT">cash_fact_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">归属原付款</TD></TR><TR><TD PORT="refund_id" WIDTH="148" ALIGN="LEFT">refund_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="372" ALIGN="LEFT">可关联退款</TD></TR><TR><TD PORT="kind" WIDTH="148" ALIGN="LEFT">kind</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">FEE/FEE_RETURN/ADJUSTMENT</TD></TR><TR><TD PORT="amount_fen" WIDTH="148" ALIGN="LEFT">amount_fen</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="372" ALIGN="LEFT">带方向金额；未知为空非0</TD></TR><TR><TD PORT="state" WIDTH="148" ALIGN="LEFT">state</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">UNKNOWN/VERIFIED</TD></TR><TR><TD PORT="occurred_at" WIDTH="148" ALIGN="LEFT">occurred_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="372" ALIGN="LEFT">可信发生</TD></TR><TR><TD PORT="evidence_ref" WIDTH="148" ALIGN="LEFT">evidence_ref</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(128)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">受限账单/核实来源</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id)</TD></TR></TABLE>>];
}
subgraph cluster_3 { label="统一MySQL · xj_play / 权益"; color="#a8b9ad";
xj_grant [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_grant · 权益授予来源</B></TD></TR><TR><TD PORT="id" WIDTH="148" ALIGN="LEFT">id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="148" ALIGN="LEFT">public_id</TD><TD  WIDTH="208" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="148" ALIGN="LEFT">created_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="subject_id" WIDTH="148" ALIGN="LEFT">subject_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">原主体</TD></TR><TR><TD PORT="game_id" WIDTH="148" ALIGN="LEFT">game_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">作品</TD></TR><TR><TD PORT="source_kind" WIDTH="148" ALIGN="LEFT">source_kind</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">ORDER/FREE/UPGRADE/COMPENSATION</TD></TR><TR><TD PORT="source_ref" WIDTH="148" ALIGN="LEFT">source_ref</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">对应稳定业务编号，服务端检查类型与归属</TD></TR><TR><TD PORT="cash_fact_id" WIDTH="148" ALIGN="LEFT">cash_fact_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="372" ALIGN="LEFT">现金来源可空，免费/零补款不造付款</TD></TR><TR><TD PORT="state" WIDTH="148" ALIGN="LEFT">state</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">PENDING/ACTIVE/REVIEW/REVOKED</TD></TR><TR><TD PORT="revision" WIDTH="148" ALIGN="LEFT">revision</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">来源处置并发</TD></TR><TR><TD PORT="reason" WIDTH="148" ALIGN="LEFT">reason</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(1000)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="372" ALIGN="LEFT">人工补偿/处置原因</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (source_kind,source_ref)</TD></TR></TABLE>>];
xj_grant_scope [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_grant_scope · 授予的稳定覆盖</B></TD></TR><TR><TD PORT="id" WIDTH="128" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="128" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="128" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="grant_id" WIDTH="128" ALIGN="LEFT">grant_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">来源</TD></TR><TR><TD PORT="content_id" WIDTH="128" ALIGN="LEFT">content_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">同作品内容key</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (grant_id,content_id)</TD></TR></TABLE>>];
xj_upgrade [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_upgrade · 差价/零补款升级</B></TD></TR><TR><TD PORT="id" WIDTH="128" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="128" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="178" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="128" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="subject_id" WIDTH="128" ALIGN="LEFT">subject_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">已验证主体</TD></TR><TR><TD PORT="game_id" WIDTH="128" ALIGN="LEFT">game_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">作品</TD></TR><TR><TD PORT="quote_id" WIDTH="128" ALIGN="LEFT">quote_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">ref,uk NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">升级报价</TD></TR><TR><TD PORT="order_id" WIDTH="128" ALIGN="LEFT">order_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="438" ALIGN="LEFT">正补款关联订单；0补款为空</TD></TR><TR><TD PORT="grant_id" WIDTH="128" ALIGN="LEFT">grant_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="438" ALIGN="LEFT">核实交付后关联买断授予</TD></TR><TR><TD PORT="credit_fen" WIDTH="128" ALIGN="LEFT">credit_fen</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">合格来源去重抵扣</TD></TR><TR><TD PORT="due_fen" WIDTH="128" ALIGN="LEFT">due_fen</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">新增实付，0不触渠道</TD></TR><TR><TD PORT="state" WIDTH="128" ALIGN="LEFT">state</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="438" ALIGN="LEFT">RESERVED/PENDING/DELIVERED/REVIEW/REVOKED</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (quote_id)</TD></TR></TABLE>>];
xj_upgrade_allocation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_upgrade_allocation · 抵扣保留与释放</B></TD></TR><TR><TD PORT="id" WIDTH="148" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="148" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="148" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="upgrade_id" WIDTH="148" ALIGN="LEFT">upgrade_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">升级</TD></TR><TR><TD PORT="cash_fact_id" WIDTH="148" ALIGN="LEFT">cash_fact_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">原净实付来源</TD></TR><TR><TD PORT="amount_fen" WIDTH="148" ALIGN="LEFT">amount_fen</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">该现金用于本次抵扣额</TD></TR><TR><TD PORT="state" WIDTH="148" ALIGN="LEFT">state</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">RESERVED/COMMITTED/RELEASED</TD></TR><TR><TD PORT="released_at" WIDTH="148" ALIGN="LEFT">released_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="372" ALIGN="LEFT">仅撤升级/已核实关闭后释放</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (upgrade_id,cash_fact_id)</TD></TR></TABLE>>];
}
subgraph cluster_4 { label="统一MySQL · xj_play / 运行存档"; color="#a8b9ad";
xj_run [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_run · 一次受限运行</B></TD></TR><TR><TD PORT="id" WIDTH="128" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="408" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="128" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="408" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="128" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="408" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="session_id" WIDTH="128" ALIGN="LEFT">session_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="408" ALIGN="LEFT">当前宿主会话</TD></TR><TR><TD PORT="subject_id" WIDTH="128" ALIGN="LEFT">subject_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="408" ALIGN="LEFT">匿名试玩为空</TD></TR><TR><TD PORT="version_id" WIDTH="128" ALIGN="LEFT">version_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="408" ALIGN="LEFT">实际游戏版本</TD></TR><TR><TD PORT="mode" WIDTH="128" ALIGN="LEFT">mode</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="408" ALIGN="LEFT">TRIAL/FREE/OWNED/PREVIEW</TD></TR><TR><TD PORT="state" WIDTH="128" ALIGN="LEFT">state</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="408" ALIGN="LEFT">AUTHORIZED/READY/EXITED/FAILED/REVOKED</TD></TR><TR><TD PORT="generation" WIDTH="128" ALIGN="LEFT">generation</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="408" ALIGN="LEFT">账号会话代次，变化即拒旧上下文</TD></TR><TR><TD PORT="ready_at" WIDTH="128" ALIGN="LEFT">ready_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="408" ALIGN="LEFT">游戏确认可交互</TD></TR><TR><TD PORT="expires_at" WIDTH="128" ALIGN="LEFT">expires_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="408" ALIGN="LEFT">服务端有效边界</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id)</TD></TR></TABLE>>];
xj_save_blob [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_save_blob · 不透明不可变档</B></TD></TR><TR><TD PORT="id" WIDTH="198" ALIGN="LEFT">id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="198" ALIGN="LEFT">public_id</TD><TD  WIDTH="208" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="198" ALIGN="LEFT">created_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="subject_id" WIDTH="198" ALIGN="LEFT">subject_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">归属</TD></TR><TR><TD PORT="version_id" WIDTH="198" ALIGN="LEFT">version_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">产生版本</TD></TR><TR><TD PORT="storage_object_id" WIDTH="198" ALIGN="LEFT">storage_object_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">精确私人对象，不与其他主体去重共享</TD></TR><TR><TD PORT="format" WIDTH="198" ALIGN="LEFT">format</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">游戏声明的格式</TD></TR><TR><TD PORT="state" WIDTH="198" ALIGN="LEFT">state</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">STAGED/REFERENCED/ORPHAN/DELETED</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id)</TD></TR></TABLE>>];
xj_save_head [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_save_head · 当前档与上一恢复点</B></TD></TR><TR><TD PORT="id" WIDTH="188" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="188" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="188" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="subject_id" WIDTH="188" ALIGN="LEFT">subject_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">账号</TD></TR><TR><TD PORT="game_id" WIDTH="188" ALIGN="LEFT">game_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">作品</TD></TR><TR><TD PORT="current_blob_id" WIDTH="188" ALIGN="LEFT">current_blob_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="372" ALIGN="LEFT">当前档</TD></TR><TR><TD PORT="previous_blob_id" WIDTH="188" ALIGN="LEFT">previous_blob_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="372" ALIGN="LEFT">上一已确认恢复点</TD></TR><TR><TD PORT="revision" WIDTH="188" ALIGN="LEFT">revision</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">CAS修订</TD></TR><TR><TD PORT="conflict_state" WIDTH="188" ALIGN="LEFT">conflict_state</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">NONE/PENDING</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (subject_id,game_id)</TD></TR></TABLE>>];
xj_save_operation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_save_operation · 可查询保存动作</B></TD></TR><TR><TD PORT="id" WIDTH="198" ALIGN="LEFT">id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="198" ALIGN="LEFT">public_id</TD><TD  WIDTH="208" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="198" ALIGN="LEFT">created_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="head_id" WIDTH="198" ALIGN="LEFT">head_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">账号作品档头</TD></TR><TR><TD PORT="blob_id" WIDTH="198" ALIGN="LEFT">blob_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="548" ALIGN="LEFT">候选源</TD></TR><TR><TD PORT="operation_key" WIDTH="198" ALIGN="LEFT">operation_key</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">同动作重试稳定，按主体/动作校验</TD></TR><TR><TD PORT="action" WIDTH="198" ALIGN="LEFT">action</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">WRITE/IMPORT/RESTORE/RESTART；读取与兼容确认分别走专用接口</TD></TR><TR><TD PORT="base_revision" WIDTH="198" ALIGN="LEFT">base_revision</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">玩家所见目标修订</TD></TR><TR><TD PORT="result_revision" WIDTH="198" ALIGN="LEFT">result_revision</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="548" ALIGN="LEFT">核实成功后的修订</TD></TR><TR><TD PORT="state" WIDTH="198" ALIGN="LEFT">state</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="548" ALIGN="LEFT">ACCEPTED/PENDING/SUCCEEDED/CONFLICT/FAILED</TD></TR><TR><TD PORT="game_confirmed_at" WIDTH="198" ALIGN="LEFT">game_confirmed_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="548" ALIGN="LEFT">恢复需游戏确认兼容，不把读出当成功</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (head_id,operation_key)</TD></TR></TABLE>>];
xj_save_conflict [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_save_conflict · 双方冲突来源</B></TD></TR><TR><TD PORT="id" WIDTH="158" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="158" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="158" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="head_id" WIDTH="158" ALIGN="LEFT">head_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">被冻结普通替换的档头</TD></TR><TR><TD PORT="left_blob_id" WIDTH="158" ALIGN="LEFT">left_blob_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">已接收云端来源</TD></TR><TR><TD PORT="right_blob_id" WIDTH="158" ALIGN="LEFT">right_blob_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">已接收候选来源</TD></TR><TR><TD PORT="state" WIDTH="158" ALIGN="LEFT">state</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">OPEN/RESOLVED/DELETED</TD></TR><TR><TD PORT="resolution" WIDTH="158" ALIGN="LEFT">resolution</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="372" ALIGN="LEFT">玩家明确选择及预期修订</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id)</TD></TR></TABLE>>];
}
subgraph cluster_5 { label="统一MySQL · xj_play / 对象存储"; color="#a8b9ad";
xj_storage_write [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_storage_write · 可恢复上传计划</B></TD></TR><TR><TD PORT="id" WIDTH="218" ALIGN="LEFT">id</TD><TD  WIDTH="288" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="828" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="218" ALIGN="LEFT">public_id</TD><TD  WIDTH="288" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="828" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="218" ALIGN="LEFT">created_at</TD><TD  WIDTH="288" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="828" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="reserved_object_id" WIDTH="218" ALIGN="LEFT">reserved_object_id</TD><TD  WIDTH="288" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="828" ALIGN="LEFT">上传前预留的稳定objectId；不是已核实可用对象关联</TD></TR><TR><TD PORT="principal_ref" WIDTH="218" ALIGN="LEFT">principal_ref</TD><TD  WIDTH="288" ALIGN="LEFT">VARCHAR(128) ASCII BINARY</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="828" ALIGN="LEFT">服务端可信执行主体/匿名上下文，不信客户端自报</TD></TR><TR><TD PORT="business_type" WIDTH="218" ALIGN="LEFT">business_type</TD><TD  WIDTH="288" ALIGN="LEFT">VARCHAR(32) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="828" ALIGN="LEFT">GAME_VERSION/SAVE_OPERATION/PAYMENT_NOTICE</TD></TR><TR><TD PORT="business_ref" WIDTH="218" ALIGN="LEFT">business_ref</TD><TD  WIDTH="288" ALIGN="LEFT">VARCHAR(128) ASCII BINARY</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="828" ALIGN="LEFT">受控业务作用域；服务端核本人/作品/收件归属</TD></TR><TR><TD PORT="operation_key" WIDTH="218" ALIGN="LEFT">operation_key</TD><TD  WIDTH="288" ALIGN="LEFT">VARCHAR(128) ASCII BINARY</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="828" ALIGN="LEFT">同一逻辑上传重试稳定；资源按项区分</TD></TR><TR><TD PORT="plan_digest" WIDTH="218" ALIGN="LEFT">plan_digest</TD><TD  WIDTH="288" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="828" ALIGN="LEFT">包含归属、定位及预期元数据的规范计划SHA-256</TD></TR><TR><TD PORT="storage_profile_ref" WIDTH="218" ALIGN="LEFT">storage_profile_ref</TD><TD  WIDTH="288" ALIGN="LEFT">VARCHAR(128) ASCII BINARY</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="828" ALIGN="LEFT">上传前固定配置版本；不含凭据</TD></TR><TR><TD PORT="bucket_role" WIDTH="218" ALIGN="LEFT">bucket_role</TD><TD  WIDTH="288" ALIGN="LEFT">VARCHAR(16) ASCII BINARY</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="828" ALIGN="LEFT">GAME/SAVE/EVIDENCE</TD></TR><TR><TD PORT="object_key" WIDTH="218" ALIGN="LEFT">object_key</TD><TD  WIDTH="288" ALIGN="LEFT">VARCHAR(1024) ASCII BINARY</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="828" ALIGN="LEFT">上传前固定不透明key，一计划独占</TD></TR><TR><TD PORT="expected_meta" WIDTH="218" ALIGN="LEFT">expected_meta</TD><TD  WIDTH="288" ALIGN="LEFT">JSON</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="828" ALIGN="LEFT">审核后的预期明文/上传字节长度与摘要、MIME及必要加密引用，无正文/密钥</TD></TR><TR><TD PORT="candidate_versions" WIDTH="218" ALIGN="LEFT">candidate_versions</TD><TD  WIDTH="288" ALIGN="LEFT">JSON</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="828" ALIGN="LEFT">可能已落物的精确非null版本及核验结果；有界，异常超量隔离不截断丢证</TD></TR><TR><TD PORT="result_object_id" WIDTH="218" ALIGN="LEFT">result_object_id</TD><TD  WIDTH="288" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">ref,uk NULL</TD><TD  WIDTH="828" ALIGN="LEFT">核验通过后唯一接受对象；未知时为空</TD></TR><TR><TD PORT="state" WIDTH="218" ALIGN="LEFT">state</TD><TD  WIDTH="288" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="828" ALIGN="LEFT">RESERVED/UPLOADING/UNKNOWN/VERIFIED/ABANDONED/CLEANUP_PENDING/COMPLETE/EXCEPTION</TD></TR><TR><TD PORT="writer_generation" WIDTH="218" ALIGN="LEFT">writer_generation</TD><TD  WIDTH="288" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="828" ALIGN="LEFT">平台上传执行代次；不冒称可直接阻止底层旧流</TD></TR><TR><TD PORT="lease_until" WIDTH="218" ALIGN="LEFT">lease_until</TD><TD  WIDTH="288" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="828" ALIGN="LEFT">任务认领租约；过期不证明旧写者停止</TD></TR><TR><TD PORT="verified_at" WIDTH="218" ALIGN="LEFT">verified_at</TD><TD  WIDTH="288" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="828" ALIGN="LEFT">接受版本核验完成</TD></TR><TR><TD PORT="cleanup_receipt" WIDTH="218" ALIGN="LEFT">cleanup_receipt</TD><TD  WIDTH="288" ALIGN="LEFT">JSON</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="828" ALIGN="LEFT">候选/迟到版本及未完成上传的精确处置回执</TD></TR><TR><TD PORT="revision" WIDTH="218" ALIGN="LEFT">revision</TD><TD  WIDTH="288" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="828" ALIGN="LEFT">上传核验/放弃/清理并发守卫</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (reserved_object_id); (principal_ref,business_type,business_ref,operation_key); (storage_profile_ref,bucket_role,object_key); (result_object_id)</TD></TR></TABLE>>];
xj_storage_object [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_storage_object · 精确存储对象引用</B></TD></TR><TR><TD PORT="id" WIDTH="218" ALIGN="LEFT">id</TD><TD  WIDTH="288" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="588" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="218" ALIGN="LEFT">public_id</TD><TD  WIDTH="288" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="588" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="218" ALIGN="LEFT">created_at</TD><TD  WIDTH="288" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="588" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="storage_profile_ref" WIDTH="218" ALIGN="LEFT">storage_profile_ref</TD><TD  WIDTH="288" ALIGN="LEFT">VARCHAR(128) ASCII BINARY</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="588" ALIGN="LEFT">不可变存储配置版本引用，无endpoint或凭据</TD></TR><TR><TD PORT="bucket_role" WIDTH="218" ALIGN="LEFT">bucket_role</TD><TD  WIDTH="288" ALIGN="LEFT">VARCHAR(16) ASCII BINARY</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="588" ALIGN="LEFT">GAME/SAVE/EVIDENCE；映射私有桶，非实际桶名</TD></TR><TR><TD PORT="object_key" WIDTH="218" ALIGN="LEFT">object_key</TD><TD  WIDTH="288" ALIGN="LEFT">VARCHAR(1024) ASCII BINARY</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="588" ALIGN="LEFT">服务端生成不透明key；不含邮箱或剧情</TD></TR><TR><TD PORT="storage_version_id" WIDTH="218" ALIGN="LEFT">storage_version_id</TD><TD  WIDTH="288" ALIGN="LEFT">VARBINARY(1024)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="588" ALIGN="LEFT">存储返回的原始版本标识，非空且非字面null；超平台上限拒绝不截断</TD></TR><TR><TD PORT="digest" WIDTH="218" ALIGN="LEFT">digest</TD><TD  WIDTH="288" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="588" ALIGN="LEFT">约定编码后未压缩明文字节SHA-256，非ETag</TD></TR><TR><TD PORT="byte_size" WIDTH="218" ALIGN="LEFT">byte_size</TD><TD  WIDTH="288" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="588" ALIGN="LEFT">约定编码后未压缩字节；SAVE≤1048576</TD></TR><TR><TD PORT="stored_digest" WIDTH="218" ALIGN="LEFT">stored_digest</TD><TD  WIDTH="288" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="588" ALIGN="LEFT">实际上传字节SHA-256；未变换时等于digest</TD></TR><TR><TD PORT="stored_byte_size" WIDTH="218" ALIGN="LEFT">stored_byte_size</TD><TD  WIDTH="288" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="588" ALIGN="LEFT">实际上传字节数；不等同副本/备份物理占用</TD></TR><TR><TD PORT="mime" WIDTH="218" ALIGN="LEFT">mime</TD><TD  WIDTH="288" ALIGN="LEFT">VARCHAR(128)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="588" ALIGN="LEFT">审核MIME及nosniff，不信上传者自报</TD></TR><TR><TD PORT="etag" WIDTH="218" ALIGN="LEFT">etag</TD><TD  WIDTH="288" ALIGN="LEFT">VARBINARY(1024)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="588" ALIGN="LEFT">存储条件比较令牌；不替代摘要或版本</TD></TR><TR><TD PORT="encryption_key_ref" WIDTH="218" ALIGN="LEFT">encryption_key_ref</TD><TD  WIDTH="288" ALIGN="LEFT">VARCHAR(128) ASCII BINARY</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="588" ALIGN="LEFT">环境密钥版本引用；无真实密钥</TD></TR><TR><TD PORT="encryption_meta" WIDTH="218" ALIGN="LEFT">encryption_meta</TD><TD  WIDTH="288" ALIGN="LEFT">JSON</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="588" ALIGN="LEFT">应用加密算法/nonce/tag等必要恢复元数据，无密钥</TD></TR><TR><TD PORT="state" WIDTH="218" ALIGN="LEFT">state</TD><TD  WIDTH="288" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="588" ALIGN="LEFT">STAGED/AVAILABLE/DELETE_PENDING/LOGICALLY_DELETED/PURGED</TD></TR><TR><TD PORT="verified_at" WIDTH="218" ALIGN="LEFT">verified_at</TD><TD  WIDTH="288" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="588" ALIGN="LEFT">精确版本持久核验完成；AVAILABLE前必填</TD></TR><TR><TD PORT="purge_not_before" WIDTH="218" ALIGN="LEFT">purge_not_before</TD><TD  WIDTH="288" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="588" ALIGN="LEFT">引用/重试/备份窗口综合下界，非到期自动删除</TD></TR><TR><TD PORT="cleanup_receipt" WIDTH="218" ALIGN="LEFT">cleanup_receipt</TD><TD  WIDTH="288" ALIGN="LEFT">JSON</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="588" ALIGN="LEFT">最小精确清理计划、依赖结果及副本/备份消退证据，不含正文/密钥</TD></TR><TR><TD PORT="purged_at" WIDTH="218" ALIGN="LEFT">purged_at</TD><TD  WIDTH="288" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="588" ALIGN="LEFT">全部适用消退证据核实；不是DELETE返回时间</TD></TR><TR><TD PORT="revision" WIDTH="218" ALIGN="LEFT">revision</TD><TD  WIDTH="288" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="588" ALIGN="LEFT">对象引用提交与清理共用的并发守卫</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (storage_profile_ref,bucket_role,object_key,storage_version_id)</TD></TR></TABLE>>];
}
subgraph cluster_6 { label="统一MySQL · xj_play / 治理运营"; color="#a8b9ad";
xj_support_case [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_support_case · 人工售后与非现金问题</B></TD></TR><TR><TD PORT="id" WIDTH="228" ALIGN="LEFT">id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="228" ALIGN="LEFT">public_id</TD><TD  WIDTH="208" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="228" ALIGN="LEFT">created_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="subject_id" WIDTH="228" ALIGN="LEFT">subject_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">本人受控访问</TD></TR><TR><TD PORT="business_type" WIDTH="228" ALIGN="LEFT">business_type</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">ORDER/GRANT/UPGRADE</TD></TR><TR><TD PORT="business_ref" WIDTH="228" ALIGN="LEFT">business_ref</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">类型与归属由后端核验；非现金允许无订单</TD></TR><TR><TD PORT="category" WIDTH="228" ALIGN="LEFT">category</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(32)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">重复收款/交付/运行/主观/撤销等</TD></TR><TR><TD PORT="description" WIDTH="228" ALIGN="LEFT">description</TD><TD  WIDTH="208" ALIGN="LEFT">TEXT</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">1–1000码点，首版无附件，不收密码/完整存档</TD></TR><TR><TD PORT="state" WIDTH="228" ALIGN="LEFT">state</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">ACCEPTED/REVIEWING/NEED_INFO/PROPOSED/EXECUTING/CLOSED</TD></TR><TR><TD PORT="first_human_at" WIDTH="228" ALIGN="LEFT">first_human_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="568" ALIGN="LEFT">人工首回，自动回执不算</TD></TR><TR><TD PORT="last_human_update_at" WIDTH="228" ALIGN="LEFT">last_human_update_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="568" ALIGN="LEFT">持续处理中更新</TD></TR><TR><TD PORT="next_review_at" WIDTH="228" ALIGN="LEFT">next_review_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">下一处理及逾期接手</TD></TR><TR><TD PORT="operator_ref" WIDTH="228" ALIGN="LEFT">operator_ref</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="568" ALIGN="LEFT">受限后台处理者</TD></TR><TR><TD PORT="approved_plan" WIDTH="228" ALIGN="LEFT">approved_plan</TD><TD  WIDTH="208" ALIGN="LEFT">JSON</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="568" ALIGN="LEFT">受控售后方案；逐笔现金与撤销来源，非现金允许无退款</TD></TR><TR><TD PORT="plan_revision" WIDTH="228" ALIGN="LEFT">plan_revision</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="568" ALIGN="LEFT">批准方案修订；执行绑定此版不得擅自替换</TD></TR><TR><TD PORT="revision" WIDTH="228" ALIGN="LEFT">revision</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="568" ALIGN="LEFT">批准/执行并发守卫</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id)</TD></TR></TABLE>>];
xj_support_message [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_support_message · 售后对话与人工处理留痕</B></TD></TR><TR><TD PORT="id" WIDTH="148" ALIGN="LEFT">id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="148" ALIGN="LEFT">public_id</TD><TD  WIDTH="208" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="148" ALIGN="LEFT">created_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="support_id" WIDTH="148" ALIGN="LEFT">support_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">具体本人售后个案</TD></TR><TR><TD PORT="role" WIDTH="148" ALIGN="LEFT">role</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">PLAYER/OPERATOR/SYSTEM；由服务端识别</TD></TR><TR><TD PORT="operator_ref" WIDTH="148" ALIGN="LEFT">operator_ref</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="372" ALIGN="LEFT">仅管理员消息的受限可信身份</TD></TR><TR><TD PORT="body" WIDTH="148" ALIGN="LEFT">body</TD><TD  WIDTH="208" ALIGN="LEFT">TEXT</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">1–1000码点；无附件，不记录密钥或完整存档</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id)</TD></TR></TABLE>>];
xj_cleanup_job [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_cleanup_job · 分类清理与回执</B></TD></TR><TR><TD PORT="id" WIDTH="138" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="138" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="138" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="deletion_id" WIDTH="138" ALIGN="LEFT">deletion_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">AD1最终处理范围</TD></TR><TR><TD PORT="category" WIDTH="138" ALIGN="LEFT">category</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(32)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">PROFILE/SAVE/CONFLICT/EVENT/GAME_RECEIPT/BACKUP</TD></TR><TR><TD PORT="state" WIDTH="138" ALIGN="LEFT">state</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(24)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">PENDING/RUNNING/BLOCKED/SUCCEEDED/EXCEPTION</TD></TR><TR><TD PORT="deadline_at" WIDTH="138" ALIGN="LEFT">deadline_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="498" ALIGN="LEFT">按7日/30日等分类目标</TD></TR><TR><TD PORT="cursor" WIDTH="138" ALIGN="LEFT">cursor</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(512)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="498" ALIGN="LEFT">最小重试游标，无剧情</TD></TR><TR><TD PORT="receipt" WIDTH="138" ALIGN="LEFT">receipt</TD><TD  WIDTH="178" ALIGN="LEFT">JSON</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="498" ALIGN="LEFT">实际删除/异常/保留范围</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (deletion_id,category)</TD></TR></TABLE>>];
xj_retention_hold [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_retention_hold · 最小留存例外</B></TD></TR><TR><TD PORT="id" WIDTH="138" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="138" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="138" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="subject_id" WIDTH="138" ALIGN="LEFT">subject_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">关联主体墓碑</TD></TR><TR><TD PORT="object_type" WIDTH="138" ALIGN="LEFT">object_type</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(32)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">具体受限对象类别</TD></TR><TR><TD PORT="object_ref" WIDTH="138" ALIGN="LEFT">object_ref</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(128)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">具体对象，不冻结整个人数据</TD></TR><TR><TD PORT="basis" WIDTH="138" ALIGN="LEFT">basis</TD><TD  WIDTH="178" ALIGN="LEFT">TEXT</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">处理目的/依据/权限</TD></TR><TR><TD PORT="review_at" WIDTH="138" ALIGN="LEFT">review_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">每90自然日复核</TD></TR><TR><TD PORT="released_at" WIDTH="138" ALIGN="LEFT">released_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="372" ALIGN="LEFT">必要性结束，按目标清理</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id)</TD></TR></TABLE>>];
xj_outbox [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_outbox · 可靠业务任务</B></TD></TR><TR><TD PORT="id" WIDTH="198" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="508" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="198" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="508" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="198" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="508" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="business_type" WIDTH="198" ALIGN="LEFT">business_type</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(32)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="508" ALIGN="LEFT">GRANT/REVOKE/RECONCILE/DELETE/RENDER/RESTRICTION</TD></TR><TR><TD PORT="business_ref" WIDTH="198" ALIGN="LEFT">business_ref</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(128)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="508" ALIGN="LEFT">稳定业务标识</TD></TR><TR><TD PORT="business_revision" WIDTH="198" ALIGN="LEFT">business_revision</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="508" ALIGN="LEFT">同业务效果版本</TD></TR><TR><TD PORT="payload" WIDTH="198" ALIGN="LEFT">payload</TD><TD  WIDTH="178" ALIGN="LEFT">JSON</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="508" ALIGN="LEFT">最小参数，不含长期凭据/完整剧情</TD></TR><TR><TD PORT="state" WIDTH="198" ALIGN="LEFT">state</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="508" ALIGN="LEFT">READY/LEASED/DONE/RETRY/DEAD</TD></TR><TR><TD PORT="next_attempt_at" WIDTH="198" ALIGN="LEFT">next_attempt_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="508" ALIGN="LEFT">可重试时刻</TD></TR><TR><TD PORT="lease_until" WIDTH="198" ALIGN="LEFT">lease_until</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="508" ALIGN="LEFT">崩溃后可认领</TD></TR><TR><TD PORT="attempts" WIDTH="198" ALIGN="LEFT">attempts</TD><TD  WIDTH="178" ALIGN="LEFT">INT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="508" ALIGN="LEFT">重试次数</TD></TR><TR><TD PORT="revision" WIDTH="198" ALIGN="LEFT">revision</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="508" ALIGN="LEFT">后台重试与任务认领并发修订</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (business_type,business_ref,business_revision)</TD></TR></TABLE>>];
xj_idempotency [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_idempotency · 请求幂等结果</B></TD></TR><TR><TD PORT="id" WIDTH="168" ALIGN="LEFT">id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="168" ALIGN="LEFT">public_id</TD><TD  WIDTH="208" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="168" ALIGN="LEFT">created_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="principal_ref" WIDTH="168" ALIGN="LEFT">principal_ref</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">可信主体或受控匿名上下文</TD></TR><TR><TD PORT="action" WIDTH="168" ALIGN="LEFT">action</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">动作与对象作用域</TD></TR><TR><TD PORT="request_key" WIDTH="168" ALIGN="LEFT">request_key</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">稳定客户端操作键</TD></TR><TR><TD PORT="payload_digest" WIDTH="168" ALIGN="LEFT">payload_digest</TD><TD  WIDTH="208" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">规范化载荷摘要</TD></TR><TR><TD PORT="result_ref" WIDTH="168" ALIGN="LEFT">result_ref</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="372" ALIGN="LEFT">持久业务结果引用</TD></TR><TR><TD PORT="state" WIDTH="168" ALIGN="LEFT">state</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">PENDING/SUCCEEDED/FAILED</TD></TR><TR><TD PORT="expires_at" WIDTH="168" ALIGN="LEFT">expires_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="372" ALIGN="LEFT">结果缓存到期不废除持久唯一关系</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (principal_ref,action,request_key)</TD></TR></TABLE>>];
xj_audit_event [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_audit_event · 受限操作审计</B></TD></TR><TR><TD PORT="id" WIDTH="158" ALIGN="LEFT">id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="158" ALIGN="LEFT">public_id</TD><TD  WIDTH="208" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="158" ALIGN="LEFT">created_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="operator_ref" WIDTH="158" ALIGN="LEFT">operator_ref</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">可信后台/系统执行主体</TD></TR><TR><TD PORT="action" WIDTH="158" ALIGN="LEFT">action</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">白名单动作</TD></TR><TR><TD PORT="business_type" WIDTH="158" ALIGN="LEFT">business_type</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(32)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">对象类型</TD></TR><TR><TD PORT="business_ref" WIDTH="158" ALIGN="LEFT">business_ref</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">对象编号</TD></TR><TR><TD PORT="trace_id" WIDTH="158" ALIGN="LEFT">trace_id</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">不含密钥的关联</TD></TR><TR><TD PORT="result" WIDTH="158" ALIGN="LEFT">result</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(32)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="372" ALIGN="LEFT">实际结果</TD></TR><TR><TD PORT="reason" WIDTH="158" ALIGN="LEFT">reason</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(1000)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="372" ALIGN="LEFT">必要理由，禁止敏感整包日志</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id)</TD></TR></TABLE>>];
xj_analytics_event [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_analytics_event · 普通行为明细</B></TD></TR><TR><TD PORT="id" WIDTH="138" ALIGN="LEFT">id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="826" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="138" ALIGN="LEFT">public_id</TD><TD  WIDTH="208" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="826" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="138" ALIGN="LEFT">created_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="826" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="run_id" WIDTH="138" ALIGN="LEFT">run_id</TD><TD  WIDTH="208" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="826" ALIGN="LEFT">允许公开浏览事件无run</TD></TR><TR><TD PORT="event_key" WIDTH="138" ALIGN="LEFT">event_key</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="826" ALIGN="LEFT">服务端绑定环境/来源/可信作用域与原event_ref的SHA256小写十六进制键，固定64字符；不是客户端原编号</TD></TR><TR><TD PORT="event_type" WIDTH="138" ALIGN="LEFT">event_type</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="826" ALIGN="LEFT">固定31项中获准来源事件</TD></TR><TR><TD PORT="subject_ref" WIDTH="138" ALIGN="LEFT">subject_ref</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="826" ALIGN="LEFT">可关联标识，仍属待清理个人数据</TD></TR><TR><TD PORT="view_ref" WIDTH="138" ALIGN="LEFT">view_ref</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(128)</TD><TD  WIDTH="138" ALIGN="LEFT"> NULL</TD><TD  WIDTH="826" ALIGN="LEFT">30分钟无活动会话，跨设备不猜合并</TD></TR><TR><TD PORT="fields" WIDTH="138" ALIGN="LEFT">fields</TD><TD  WIDTH="208" ALIGN="LEFT">JSON</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="826" ALIGN="LEFT">逐事件白名单，不存剧情/邮箱/存档</TD></TR><TR><TD PORT="occurred_at" WIDTH="138" ALIGN="LEFT">occurred_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="826" ALIGN="LEFT">客户端观察或业务可信时刻有来源区分</TD></TR><TR><TD PORT="received_at" WIDTH="138" ALIGN="LEFT">received_at</TD><TD  WIDTH="208" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="826" ALIGN="LEFT">服务端接收</TD></TR><TR><TD PORT="purpose" WIDTH="138" ALIGN="LEFT">purpose</TD><TD  WIDTH="208" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="826" ALIGN="LEFT">LIVE/TEST/PREVIEW</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (event_key)</TD></TR></TABLE>>];
xj_metric_snapshot [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_metric_snapshot · 区间指标修订</B></TD></TR><TR><TD PORT="id" WIDTH="208" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="208" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="208" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="metric" WIDTH="208" ALIGN="LEFT">metric</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">M-01至M-11</TD></TR><TR><TD PORT="period_start" WIDTH="208" ALIGN="LEFT">period_start</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">Asia/Shanghai转换后左边界</TD></TR><TR><TD PORT="period_end" WIDTH="208" ALIGN="LEFT">period_end</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">右开边界</TD></TR><TR><TD PORT="as_of" WIDTH="208" ALIGN="LEFT">as_of</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">本次核实截点</TD></TR><TR><TD PORT="definition_version" WIDTH="208" ALIGN="LEFT">definition_version</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(128)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">固定口径版本</TD></TR><TR><TD PORT="dimensions" WIDTH="208" ALIGN="LEFT">dimensions</TD><TD  WIDTH="178" ALIGN="LEFT">JSON</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">游戏/币种/模式/测试排除及缺失覆盖</TD></TR><TR><TD PORT="result" WIDTH="208" ALIGN="LEFT">result</TD><TD  WIDTH="178" ALIGN="LEFT">JSON</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="428" ALIGN="LEFT">成功/失败/未知/取消及样本/中位/P95，不编造运营值</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id)</TD></TR></TABLE>>];
}
subgraph cluster_7 { label="统一MySQL · xj_play / 恢复控制"; color="#a8b9ad";
xj_restriction_gate [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_restriction_gate · 统一库安全写入门禁</B></TD></TR><TR><TD PORT="id" WIDTH="218" ALIGN="LEFT">id</TD><TD  WIDTH="278" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="458" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="218" ALIGN="LEFT">public_id</TD><TD  WIDTH="278" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="458" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="218" ALIGN="LEFT">created_at</TD><TD  WIDTH="278" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="458" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="environment_ref" WIDTH="218" ALIGN="LEFT">environment_ref</TD><TD  WIDTH="278" ALIGN="LEFT">VARCHAR(64) ASCII BINARY</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="458" ALIGN="LEFT">逻辑环境；当前MCP库仅用于当前设计目标，不证明生产隔离</TD></TR><TR><TD PORT="authority_ref" WIDTH="218" ALIGN="LEFT">authority_ref</TD><TD  WIDTH="278" ALIGN="LEFT">CHAR(36) ASCII BINARY</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="458" ALIGN="LEFT">同库限制链标识，随全库恢复；不能自证独立权威</TD></TR><TR><TD PORT="deployment_epoch" WIDTH="218" ALIGN="LEFT">deployment_epoch</TD><TD  WIDTH="278" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="458" ALIGN="LEFT">当前运行代次；恢复后关闭外部入口再核新代次</TD></TR><TR><TD PORT="writer_identity_ref" WIDTH="218" ALIGN="LEFT">writer_identity_ref</TD><TD  WIDTH="278" ALIGN="LEFT">VARCHAR(128) ASCII BINARY</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="458" ALIGN="LEFT">受控平台写入身份引用，无凭据</TD></TR><TR><TD PORT="write_state" WIDTH="218" ALIGN="LEFT">write_state</TD><TD  WIDTH="278" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="458" ALIGN="LEFT">CLOSED/OPEN/FROZEN</TD></TR><TR><TD PORT="revision" WIDTH="218" ALIGN="LEFT">revision</TD><TD  WIDTH="278" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="458" ALIGN="LEFT">受限控制入口并发修订</TD></TR><TR><TD PORT="updated_at" WIDTH="218" ALIGN="LEFT">updated_at</TD><TD  WIDTH="278" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="458" ALIGN="LEFT">可信切换时刻，时间不代替代次</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (environment_ref)</TD></TR></TABLE>>];
xj_restriction_operation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_restriction_operation · 同库限制操作与幂等</B></TD></TR><TR><TD PORT="id" WIDTH="198" ALIGN="LEFT">id</TD><TD  WIDTH="278" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="198" ALIGN="LEFT">public_id</TD><TD  WIDTH="278" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="198" ALIGN="LEFT">created_at</TD><TD  WIDTH="278" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="operation_id" WIDTH="198" ALIGN="LEFT">operation_id</TD><TD  WIDTH="278" ALIGN="LEFT">CHAR(36) ASCII BINARY</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">服务端稳定opId，同主体/动作/请求键重试查原结果</TD></TR><TR><TD PORT="gate_id" WIDTH="198" ALIGN="LEFT">gate_id</TD><TD  WIDTH="278" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">本环境安全门禁</TD></TR><TR><TD PORT="head_id" WIDTH="198" ALIGN="LEFT">head_id</TD><TD  WIDTH="278" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">同环境限制链头</TD></TR><TR><TD PORT="initiator_ref" WIDTH="198" ALIGN="LEFT">initiator_ref</TD><TD  WIDTH="278" ALIGN="LEFT">VARCHAR(128) ASCII BINARY</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">可信发起主体/系统身份的最小引用</TD></TR><TR><TD PORT="request_key" WIDTH="198" ALIGN="LEFT">request_key</TD><TD  WIDTH="278" ALIGN="LEFT">VARCHAR(128) ASCII BINARY</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">首次请求及重试稳定，不因超时换号</TD></TR><TR><TD PORT="action" WIDTH="198" ALIGN="LEFT">action</TD><TD  WIDTH="278" ALIGN="LEFT">VARCHAR(32) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">DELETE_ACCOUNT/REVOKE_SESSION/REVOKE_GRANT/SUSPEND_GAME/CLEANUP</TD></TR><TR><TD PORT="scope_type" WIDTH="198" ALIGN="LEFT">scope_type</TD><TD  WIDTH="278" ALIGN="LEFT">VARCHAR(32) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">SUBJECT/GRANT/GAME/OBJECT白名单</TD></TR><TR><TD PORT="scope_ref" WIDTH="198" ALIGN="LEFT">scope_ref</TD><TD  WIDTH="278" ALIGN="LEFT">VARCHAR(128) ASCII BINARY</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">不透明作用域，不含邮箱/剧情</TD></TR><TR><TD PORT="expected_revision" WIDTH="198" ALIGN="LEFT">expected_revision</TD><TD  WIDTH="278" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">原业务计划的预期修订</TD></TR><TR><TD PORT="plan_schema" WIDTH="198" ALIGN="LEFT">plan_schema</TD><TD  WIDTH="278" ALIGN="LEFT">VARCHAR(32) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">最小计划确定编码版本</TD></TR><TR><TD PORT="plan_digest" WIDTH="198" ALIGN="LEFT">plan_digest</TD><TD  WIDTH="278" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">原计划确定字节摘要</TD></TR><TR><TD PORT="minimal_plan" WIDTH="198" ALIGN="LEFT">minimal_plan</TD><TD  WIDTH="278" ALIGN="LEFT">MEDIUMBLOB</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">最小限制计划，无完整剧情/正文/密钥；受实际包长与配置额度限制</TD></TR><TR><TD PORT="deployment_epoch" WIDTH="198" ALIGN="LEFT">deployment_epoch</TD><TD  WIDTH="278" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">同一提交事务核验的代次</TD></TR><TR><TD PORT="applied_seq" WIDTH="198" ALIGN="LEFT">applied_seq</TD><TD  WIDTH="278" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">同事务APPLIED事件序号；检查点可承接，检查点承接原回执，不依赖永久事件行</TD></TR><TR><TD PORT="state" WIDTH="198" ALIGN="LEFT">state</TD><TD  WIDTH="278" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">APPLIED；仅表示本次限制事务已提交，不表示清理/退款全部完成</TD></TR><TR><TD PORT="result_revision" WIDTH="198" ALIGN="LEFT">result_revision</TD><TD  WIDTH="278" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">同事务提交后的业务修订</TD></TR><TR><TD PORT="outbox_id" WIDTH="198" ALIGN="LEFT">outbox_id</TD><TD  WIDTH="278" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="658" ALIGN="LEFT">同事务的分类清理/通知等后续任务</TD></TR><TR><TD PORT="committed_at" WIDTH="198" ALIGN="LEFT">committed_at</TD><TD  WIDTH="278" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="658" ALIGN="LEFT">本地事务提交记录；不证明快照后没有记录</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (operation_id); (gate_id,initiator_ref,action,request_key)</TD></TR></TABLE>>];
xj_restriction_replay [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_restriction_replay · 同库恢复核验与排除凭据</B></TD></TR><TR><TD PORT="id" WIDTH="228" ALIGN="LEFT">id</TD><TD  WIDTH="238" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="228" ALIGN="LEFT">public_id</TD><TD  WIDTH="238" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="228" ALIGN="LEFT">created_at</TD><TD  WIDTH="238" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="recovery_ref" WIDTH="228" ALIGN="LEFT">recovery_ref</TD><TD  WIDTH="238" ALIGN="LEFT">CHAR(36) ASCII BINARY</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">一次隔离恢复/开放核验编号</TD></TR><TR><TD PORT="gate_id" WIDTH="228" ALIGN="LEFT">gate_id</TD><TD  WIDTH="238" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">本环境保持关闭的安全门禁</TD></TR><TR><TD PORT="authority_ref" WIDTH="228" ALIGN="LEFT">authority_ref</TD><TD  WIDTH="238" ALIGN="LEFT">CHAR(36) ASCII BINARY</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">恢复出的链标识，不是未丢尾部证明</TD></TR><TR><TD PORT="deployment_epoch" WIDTH="228" ALIGN="LEFT">deployment_epoch</TD><TD  WIDTH="238" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">旧写端隔离后的新代次</TD></TR><TR><TD PORT="checkpoint_id" WIDTH="228" ALIGN="LEFT">checkpoint_id</TD><TD  WIDTH="238" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="540" ALIGN="LEFT">同库检查点；起始可用genesis</TD></TR><TR><TD PORT="target_head_seq" WIDTH="228" ALIGN="LEFT">target_head_seq</TD><TD  WIDTH="238" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="540" ALIGN="LEFT">由库外可恢复证据核实的目标，未知须为空</TD></TR><TR><TD PORT="target_head_digest" WIDTH="228" ALIGN="LEFT">target_head_digest</TD><TD  WIDTH="238" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="540" ALIGN="LEFT">可信目标摘要，不能拿备份最大值自证</TD></TR><TR><TD PORT="verified_through_seq" WIDTH="228" ALIGN="LEFT">verified_through_seq</TD><TD  WIDTH="238" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">当前已核连续前缀</TD></TR><TR><TD PORT="verified_digest" WIDTH="228" ALIGN="LEFT">verified_digest</TD><TD  WIDTH="238" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">对应前缀摘要</TD></TR><TR><TD PORT="excluded_scopes" WIDTH="228" ALIGN="LEFT">excluded_scopes</TD><TD  WIDTH="238" ALIGN="LEFT">JSON</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">有可信删除/消退依据的最小禁复活范围</TD></TR><TR><TD PORT="isolated_scopes" WIDTH="228" ALIGN="LEFT">isolated_scopes</TD><TD  WIDTH="238" ALIGN="LEFT">JSON</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">覆盖缺口或游戏清理未决范围；不由缺失反推删除</TD></TR><TR><TD PORT="evidence" WIDTH="228" ALIGN="LEFT">evidence</TD><TD  WIDTH="238" ALIGN="LEFT">JSON</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">备份/binlog/最后接受范围、隔离及开放依据；未知明确登记，无密钥</TD></TR><TR><TD PORT="state" WIDTH="228" ALIGN="LEFT">state</TD><TD  WIDTH="238" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">VERIFYING/ISOLATED/READY/FAILED</TD></TR><TR><TD PORT="verified_at" WIDTH="228" ALIGN="LEFT">verified_at</TD><TD  WIDTH="238" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="540" ALIGN="LEFT">核验时刻，不能自行打开业务入口</TD></TR><TR><TD PORT="revision" WIDTH="228" ALIGN="LEFT">revision</TD><TD  WIDTH="238" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="540" ALIGN="LEFT">恢复器并发守卫</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (recovery_ref)</TD></TR></TABLE>>];
}
subgraph cluster_8 { label="统一MySQL · xj_play / 限制记录"; color="#a8b9ad";
xj_rl_head [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_rl_head · 同库限制链持久头</B></TD></TR><TR><TD PORT="id" WIDTH="238" ALIGN="LEFT">id</TD><TD  WIDTH="268" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="482" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="238" ALIGN="LEFT">public_id</TD><TD  WIDTH="268" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="482" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="238" ALIGN="LEFT">created_at</TD><TD  WIDTH="268" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="482" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="authority_ref" WIDTH="238" ALIGN="LEFT">authority_ref</TD><TD  WIDTH="268" ALIGN="LEFT">CHAR(36) ASCII BINARY</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="482" ALIGN="LEFT">环境固定链标识；全库恢复也会恢复该值</TD></TR><TR><TD PORT="environment_ref" WIDTH="238" ALIGN="LEFT">environment_ref</TD><TD  WIDTH="268" ALIGN="LEFT">VARCHAR(64) ASCII BINARY</TD><TD  WIDTH="138" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="482" ALIGN="LEFT">逻辑环境</TD></TR><TR><TD PORT="last_seq" WIDTH="238" ALIGN="LEFT">last_seq</TD><TD  WIDTH="268" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="482" ALIGN="LEFT">受行锁保护的事务计数器，genesis=0，非AUTO_INCREMENT</TD></TR><TR><TD PORT="head_digest" WIDTH="238" ALIGN="LEFT">head_digest</TD><TD  WIDTH="268" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="482" ALIGN="LEFT">本库可见最后事件摘要，不证明没有丢失尾部</TD></TR><TR><TD PORT="checkpoint_id" WIDTH="238" ALIGN="LEFT">checkpoint_id</TD><TD  WIDTH="268" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT">ref NULL</TD><TD  WIDTH="482" ALIGN="LEFT">同head已验证检查点</TD></TR><TR><TD PORT="compacted_through_seq" WIDTH="238" ALIGN="LEFT">compacted_through_seq</TD><TD  WIDTH="268" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="482" ALIGN="LEFT">可清理前缀，不超过已验证检查点</TD></TR><TR><TD PORT="revision" WIDTH="238" ALIGN="LEFT">revision</TD><TD  WIDTH="268" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="482" ALIGN="LEFT">头与压缩发布并发修订</TD></TR><TR><TD PORT="updated_at" WIDTH="238" ALIGN="LEFT">updated_at</TD><TD  WIDTH="268" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="138" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="482" ALIGN="LEFT">服务端时间，不用于事件排序</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (authority_ref); (environment_ref)</TD></TR></TABLE>>];
xj_rl_event [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_rl_event · 同库限制已提交事件</B></TD></TR><TR><TD PORT="id" WIDTH="188" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="492" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="188" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="178" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="492" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="188" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="492" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="head_id" WIDTH="188" ALIGN="LEFT">head_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="492" ALIGN="LEFT">本事件链头</TD></TR><TR><TD PORT="operation_row_id" WIDTH="188" ALIGN="LEFT">operation_row_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT">ref,uk NOT NULL</TD><TD  WIDTH="492" ALIGN="LEFT">已提交逻辑操作</TD></TR><TR><TD PORT="seq" WIDTH="188" ALIGN="LEFT">seq</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="492" ALIGN="LEFT">持头锁分配last_seq+1，与业务效果一起提交</TD></TR><TR><TD PORT="deployment_epoch" WIDTH="188" ALIGN="LEFT">deployment_epoch</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="492" ALIGN="LEFT">提交事务已核验的代次</TD></TR><TR><TD PORT="phase" WIDTH="188" ALIGN="LEFT">phase</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="492" ALIGN="LEFT">APPLIED；无跨库PREPARED/ABORTED阶段</TD></TR><TR><TD PORT="plan_digest" WIDTH="188" ALIGN="LEFT">plan_digest</TD><TD  WIDTH="178" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="492" ALIGN="LEFT">与操作和原确定记录匹配</TD></TR><TR><TD PORT="previous_digest" WIDTH="188" ALIGN="LEFT">previous_digest</TD><TD  WIDTH="178" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="492" ALIGN="LEFT">上一事件或已验证检查点末摘要</TD></TR><TR><TD PORT="event_digest" WIDTH="188" ALIGN="LEFT">event_digest</TD><TD  WIDTH="178" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="492" ALIGN="LEFT">域分离哈希：链标识、seq、epoch、前摘要和确定记录</TD></TR><TR><TD PORT="canonical_record" WIDTH="188" ALIGN="LEFT">canonical_record</TD><TD  WIDTH="178" ALIGN="LEFT">MEDIUMBLOB</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="492" ALIGN="LEFT">完整最小计划envelope及结果核验字段的确定字节，无剧情正文</TD></TR><TR><TD PORT="record_byte_size" WIDTH="188" ALIGN="LEFT">record_byte_size</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="178" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="492" ALIGN="LEFT">实际字节数，受配置额度及max_allowed_packet限制</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (head_id,seq); (operation_row_id)</TD></TR></TABLE>>];
xj_rl_checkpoint [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="4" BGCOLOR="#dae8df"><B>xj_rl_checkpoint · 同库限制检查点与消退</B></TD></TR><TR><TD PORT="id" WIDTH="198" ALIGN="LEFT">id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">pk NOT NULL</TD><TD  WIDTH="504" ALIGN="LEFT">平台内部主键，服务端生成；不作为鉴权依据</TD></TR><TR><TD PORT="public_id" WIDTH="198" ALIGN="LEFT">public_id</TD><TD  WIDTH="178" ALIGN="LEFT">CHAR(36) ASCII</TD><TD  WIDTH="148" ALIGN="LEFT">uk NOT NULL</TD><TD  WIDTH="504" ALIGN="LEFT">服务端UUID公开标识；不可猜测不代替对象授权</TD></TR><TR><TD PORT="created_at" WIDTH="198" ALIGN="LEFT">created_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="504" ALIGN="LEFT">服务端UTC创建时刻</TD></TR><TR><TD PORT="head_id" WIDTH="198" ALIGN="LEFT">head_id</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT">ref NOT NULL</TD><TD  WIDTH="504" ALIGN="LEFT">所属限制链</TD></TR><TR><TD PORT="through_seq" WIDTH="198" ALIGN="LEFT">through_seq</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="504" ALIGN="LEFT">检查点承接的连续前缀末端</TD></TR><TR><TD PORT="through_digest" WIDTH="198" ALIGN="LEFT">through_digest</TD><TD  WIDTH="178" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="504" ALIGN="LEFT">该前缀末摘要</TD></TR><TR><TD PORT="deployment_epoch" WIDTH="198" ALIGN="LEFT">deployment_epoch</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="504" ALIGN="LEFT">一致快照代次</TD></TR><TR><TD PORT="canonical_state" WIDTH="198" ALIGN="LEFT">canonical_state</TD><TD  WIDTH="178" ALIGN="LEFT">MEDIUMBLOB</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="504" ALIGN="LEFT">确定编码限制、必要计划/幂等映射、完整原回执及未决清理scope</TD></TR><TR><TD PORT="state_digest" WIDTH="198" ALIGN="LEFT">state_digest</TD><TD  WIDTH="178" ALIGN="LEFT">BINARY(32)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="504" ALIGN="LEFT">绑定链标识、覆盖边界和原确定字节</TD></TR><TR><TD PORT="state_byte_size" WIDTH="198" ALIGN="LEFT">state_byte_size</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="504" ALIGN="LEFT">有界快照长度；超过配置或包长停止压缩</TD></TR><TR><TD PORT="backup_coverage" WIDTH="198" ALIGN="LEFT">backup_coverage</TD><TD  WIDTH="178" ALIGN="LEFT">JSON</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="504" ALIGN="LEFT">所有可复活数据的备份/对象版本/游戏表恢复窗口及消退依据</TD></TR><TR><TD PORT="recovery_evidence" WIDTH="198" ALIGN="LEFT">recovery_evidence</TD><TD  WIDTH="178" ALIGN="LEFT">JSON</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="504" ALIGN="LEFT">已验证备份/导出证据引用，无密钥；本表不是库外独立证据</TD></TR><TR><TD PORT="state" WIDTH="198" ALIGN="LEFT">state</TD><TD  WIDTH="178" ALIGN="LEFT">VARCHAR(16)</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="504" ALIGN="LEFT">DRAFT/VERIFIED/RETIRED</TD></TR><TR><TD PORT="verified_at" WIDTH="198" ALIGN="LEFT">verified_at</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="504" ALIGN="LEFT">内容与可恢复性核验完成</TD></TR><TR><TD PORT="retire_not_before" WIDTH="198" ALIGN="LEFT">retire_not_before</TD><TD  WIDTH="178" ALIGN="LEFT">DATETIME(6)</TD><TD  WIDTH="148" ALIGN="LEFT"> NULL</TD><TD  WIDTH="504" ALIGN="LEFT">所有关联恢复窗口结束后的清理下界</TD></TR><TR><TD PORT="revision" WIDTH="198" ALIGN="LEFT">revision</TD><TD  WIDTH="178" ALIGN="LEFT">BIGINT UNSIGNED</TD><TD  WIDTH="148" ALIGN="LEFT"> NOT NULL</TD><TD  WIDTH="504" ALIGN="LEFT">发布检查点与清理互斥</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT">UNIQUE (public_id); (head_id,through_seq)</TD></TR></TABLE>>];
}
